<template>
  <div>
    <!-- Breadcrumb -->
    <div class="d-flex align-items-center mb-3">
      <ul class="breadcrumb">
        <li class="breadcrumb-item"><a href="javascript:;">Inspections</a></li>
        <li class="breadcrumb-item active">Inspection Templates</li>
      </ul>
    </div>

    <!-- Template Table -->
    <div class="row layout-top-spacing bg-white rounded mt-2">
      <div class="col-xl-12 col-lg-12 col-sm-12 layout-spacing">
        <div class="panel br-6 p-0">
          <div class="custom-table p-3">
            <StandardDataTable
              :columns="columns"
              :data="templates"
              :loading="isLoading"
              :filters="tableFilters"
              :defaultPageSize="tableFilters.pageSize"
              :disablePagination="false"
              :showDateFilters="false"
              :actionButtons="pageActions"
            >
              <!-- @vue-ignore -->
              <template #status="{ row: rowData }">
                <span :class="getStatusBadgeClass(rowData.status)">
                  {{ rowData.status }}
                </span>
              </template>

              <!-- @vue-ignore -->
              <template #is_active="{ row: rowData }">
                <span :class="rowData.is_active ? 'badge bg-success' : 'badge bg-secondary'">
                  {{ rowData.is_active ? 'Active' : 'Inactive' }}
                </span>
              </template>

              <!-- @vue-ignore -->
              <template #site="{ row: rowData }">
                {{ rowData.site ? rowData.site.name : 'All Sites' }}
              </template>

              <!-- @vue-ignore -->
              <template #actions="{ row: rowData }">
                <div class="d-flex gap-1">
                  <button
                    v-if="rowData.status === 'draft'"
                    class="btn btn-outline-primary btn-sm"
                    @click="editTemplate(rowData)"
                    title="Edit"
                  >
                    <i class="fa fa-edit"></i>
                  </button>
                  <button
                    class="btn btn-outline-info btn-sm"
                    @click="viewTemplate(rowData)"
                    title="View"
                  >
                    <i class="fa fa-eye"></i>
                  </button>
                  <button
                    v-if="rowData.status === 'draft'"
                    class="btn btn-outline-success btn-sm"
                    @click="confirmPublish(rowData)"
                    title="Publish"
                  >
                    <i class="fa fa-check-circle"></i>
                  </button>
                  <button
                    v-if="rowData.status === 'published'"
                    class="btn btn-outline-warning btn-sm"
                    @click="confirmRetire(rowData)"
                    title="Retire"
                  >
                    <i class="fa fa-archive"></i>
                  </button>
                  <button
                    v-if="rowData.status === 'draft'"
                    class="btn btn-outline-danger btn-sm"
                    @click="confirmDelete(rowData)"
                    title="Delete"
                  >
                    <i class="fa fa-trash"></i>
                  </button>
                </div>
              </template>
            </StandardDataTable>
          </div>
        </div>
      </div>
    </div>
  </div>
</template>

<script setup lang="ts">
import { ref, computed, onMounted } from 'vue'
import { useRouter } from 'vue-router'
import StandardDataTable from '@/components/plugins/StandardDataTable.vue'
import { inspectionService } from '@/services/inspectionService'
import { useNotification } from '@/composables/notification'

interface InspectionTemplate {
  id: number
  name: string
  version_number: number
  status: 'draft' | 'published' | 'retired'
  site?: { name: string }
  is_active: boolean
  created_at: string
}

const router = useRouter()
const { showAlert } = useNotification()

const isLoading = ref(false)
const templates = ref<InspectionTemplate[]>([])

const columns = ref<Array<{ key: string; label: string; visible: boolean; sortable: boolean }>>([
  { key: 'sno', label: '#', visible: true, sortable: false },
  { key: 'name', label: 'Template Name', visible: true, sortable: true },
  { key: 'version_number', label: 'Version', visible: true, sortable: true },
  { key: 'status', label: 'Status', visible: true, sortable: true },
  { key: 'site', label: 'Site', visible: true, sortable: false },
  { key: 'is_active', label: 'Active', visible: true, sortable: false },
  { key: 'created_at', label: 'Created', visible: true, sortable: true },
  { key: 'actions', label: 'Actions', visible: true, sortable: false }
])

const tableFilters = ref({
  search: '',
  pageSize: 15,
  currentPage: 1,
  sortField: '',
  sortDirection: 'asc',
  showAdvancedFilters: false,
  date_from: '',
  date_to: ''
})

const pageActions = computed(() => [
  {
    label: 'Refresh',
    icon: 'fa fa-sync-alt',
    class: 'btn btn-secondary',
    method: () => fetchTemplates()
  },
  {
    label: 'Create Template',
    icon: 'fa fa-plus',
    class: 'btn btn-primary',
    method: () => router.push({ name: 'inspection-template-create' })
  }
])

// ==================== Data Fetching ====================

async function fetchTemplates() {
  isLoading.value = true
  try {
    const response = await inspectionService.listTemplates(tableFilters.value)
    templates.value = response.data.data || response.data || []
  } catch (error: any) {
    showAlert('error', error?.response?.data?.message || 'Failed to load templates')
  } finally {
    isLoading.value = false
  }
}

// ==================== Actions ====================

function editTemplate(row: any) {
  router.push({ name: 'inspection-template-edit', params: { id: row.id } })
}

function viewTemplate(row: any) {
  router.push({ name: 'inspection-template-view', params: { id: row.id } })
}

async function confirmPublish(row: any) {
  const Swal = (window as any).Swal
  if (!Swal) return

  const result = await Swal.fire({
    title: 'Publish Template?',
    text: `Are you sure you want to publish "${row.name}" (v${row.version_number})? It will become read-only.`,
    icon: 'question',
    showCancelButton: true,
    confirmButtonText: 'Yes, Publish',
    confirmButtonColor: '#28a745'
  })

  if (result.isConfirmed) {
    try {
      await inspectionService.publishTemplate(row.id)
      showAlert('success', 'Template published successfully')
      fetchTemplates()
    } catch (error: any) {
      showAlert('error', error?.response?.data?.message || 'Failed to publish template')
    }
  }
}

async function confirmRetire(row: any) {
  const Swal = (window as any).Swal
  if (!Swal) return

  const result = await Swal.fire({
    title: 'Retire Template?',
    text: `Are you sure you want to retire "${row.name}" (v${row.version_number})?`,
    icon: 'warning',
    showCancelButton: true,
    confirmButtonText: 'Yes, Retire',
    confirmButtonColor: '#ffc107'
  })

  if (result.isConfirmed) {
    try {
      await inspectionService.retireTemplate(row.id)
      showAlert('success', 'Template retired successfully')
      fetchTemplates()
    } catch (error: any) {
      showAlert('error', error?.response?.data?.message || 'Failed to retire template')
    }
  }
}

async function confirmDelete(row: any) {
  const Swal = (window as any).Swal
  if (!Swal) return

  const result = await Swal.fire({
    title: 'Delete Template?',
    text: `Are you sure you want to delete "${row.name}"? This action cannot be undone.`,
    icon: 'error',
    showCancelButton: true,
    confirmButtonText: 'Yes, Delete',
    confirmButtonColor: '#dc3545'
  })

  if (result.isConfirmed) {
    try {
      await inspectionService.deleteTemplate(row.id)
      showAlert('success', 'Template deleted successfully')
      fetchTemplates()
    } catch (error: any) {
      showAlert('error', error?.response?.data?.message || 'Failed to delete template')
    }
  }
}

// ==================== Helpers ====================

function getStatusBadgeClass(status: string) {
  switch (status) {
    case 'draft': return 'badge bg-secondary'
    case 'published': return 'badge bg-success'
    case 'retired': return 'badge bg-warning text-dark'
    default: return 'badge bg-light text-dark'
  }
}

// ==================== Lifecycle ====================

onMounted(() => {
  fetchTemplates()
})
</script>
